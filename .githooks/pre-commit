#!/bin/sh
# Blocks commits that include game data or decompiled code (check_no_game_files.py) and the agent tooling's
# wording for the dev machine (check_wording.py). Enable with:
#   git config core.hooksPath .githooks
# The Microsoft Store `python` stub hangs, so a real interpreter is preferred (py launcher, then python3).
for PY in py python3 python; do
  if command -v "$PY" >/dev/null 2>&1 && timeout 5 "$PY" -c "import sys" >/dev/null 2>&1; then
    status=0
    "$PY" -B tools/check_no_game_files.py --staged || status=1
    "$PY" -B tools/check_wording.py --staged || status=1
    exit $status
  fi
done
echo "pre-commit: no Python found to run tools/check_no_game_files.py and tools/check_wording.py" >&2
exit 1
